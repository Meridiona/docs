  "keyFeatures": [
    "Ambient screen activity recording via screenpipe integration",
    "Automatic app session detection and boundary calculation",
    "AI-powered activity categorization (coding, meeting, research, etc.)",
    "AI task classification linking sessions to Jira, GitHub Issues, and Linear tickets",
    "Automatic project management sync — updates tickets without manual input",
    "MCP server exposing session data to Claude, Cursor, and other AI tools",
    "Local-first: all data stays on-device, no cloud dependency",
    "Local dashboard at http://localhost:3000 with timeline, stats, and category breakdown",
    "Direct SQLite database access for custom queries",
    "Minimal resource footprint (<1% CPU, <50 MB RAM)"
  ],
  "publicApiSurface": [
